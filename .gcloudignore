# Upload context for `gcloud builds submit` (Cloud Build). Keep it small.
.git
.gitignore
.claude
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
coverage
playwright-report
test-results
smoke-output
.playwright
# Local Python environments and real-data artifacts never enter build source staging.
**/.venv*
**/venv
**/__pycache__
**/.pytest_cache
var
# Local secrets never leave the machine (with a .gcloudignore present, .gitignore is not applied).
.env
.env.*
!.env.example
