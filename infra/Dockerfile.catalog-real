# Dedicated real-data acceptance image. Production images keep their production dependencies.
FROM node:22-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @catalog/worker build
# Vitest may write its cache while the test process runs as an ordinary user.
RUN chown -R node:node /repo
USER node
CMD ["pnpm", "test:real", "-t", "anta:"]
